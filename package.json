{
  "name": "component-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "storybook": "nx run storybook:storybook",
    "storybook:docs": "nx run storybook:storybook --docs",
    "build-storybook": "nx run storybook:build-storybook",
    "deploy-storybook": "nx run storybook:build-storybook && wrangler pages deploy dist/storybook/storybook --project-name some-angular-m3e-components",
    "build": "nx build",
    "watch": "nx build --watch --configuration development"
  },
  "private": true,
  "workspaces": [
    "components/button",
    "components/navigation/*",
    "storybook"
  ],
  "catalog": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/material": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "packageManager": "bun@1",
  "devDependencies": {
    "@angular/cdk": "catalog:",
    "@angular/common": "catalog:",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "catalog:",
    "@angular/material": "catalog:",
    "@angular/platform-browser": "^22.0.0",
    "rxjs": "catalog:",
    "tslib": "catalog:",
    "@angular-devkit/core": "^22.0.0",
    "@angular-devkit/schematics": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@compodoc/compodoc": "^1.2.1",
    "@nx/angular": "22.6.4",
    "@nx/js": "22.6.4",
    "@nx/storybook": "22.6.4",
    "@nx/web": "22.6.4",
    "@nx/workspace": "22.6.4",
    "@schematics/angular": "^22.0.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^22.0.0",
    "ng-packagr": "^22.0.0",
    "nx": "22.6.4",
    "prettier": "^3.8.1",
    "ts-node": "10.9.1",
    "typescript": "~6.0.2",
    "wrangler": "^4.95.0"
  }
}
